{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @flow4tech/app build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|sw.js|workbox-|manifest.webmanifest|icon|apple-touch-icon).*)", "destination": "/index.html" }]
}
