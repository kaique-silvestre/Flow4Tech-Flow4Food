{
  "name": "flow4tech",
  "private": true,
  "description": "Raiz do monorepo: só ferramentas de repositório (git hooks, Biome). Os pacotes estão em pnpm-workspace.yaml.",
  "scripts": {
    "prepare": "husky || true",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "arch:front": "depcruise frontend/app/src frontend/control/src frontend/design-system/src frontend/packages/api-client/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "dependency-cruiser": "18.7.2",
    "husky": "^9.1.7",
    "railway": "^3.16.0"
  }
}
