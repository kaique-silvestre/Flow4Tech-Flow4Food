. "$(dirname "$0")/_protegidas.sh"

# 1. Nenhum push direto para branch protegida (o GitHub também deve proteger; isto falha mais cedo).
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  nome=${remote_ref#refs/heads/}
  if E_protegida "$nome"; then
    echo "ERRO: push direto para '$nome' não é permitido (ADR-016). Abra um PR a partir de uma branch de trabalho." >&2
    exit 1
  fi
done

# 2. Testes antes do push (rápidos; os de integração com Docker rodam no CI, ou aqui com PRE_PUSH_FULL=1).
set -e
if [ -d backend ] && command -v dotnet >/dev/null 2>&1; then
  echo "pre-push: dotnet build (warnings são erros)"
  dotnet build backend/Flow4Tech.sln --nologo -v q
  echo "pre-push: testes de arquitetura e unitários (sem Docker)"
  dotnet test backend/tests/Architecture/Flow4Tech.Architecture.Tests.csproj --no-build --nologo -v q
  dotnet test backend/tests/Flow4Tech.Tests/Flow4Tech.Tests.csproj --no-build --nologo -v q --filter "FullyQualifiedName!~Endpoints&FullyQualifiedName!~Integration"
  if [ "${PRE_PUSH_FULL:-0}" = "1" ]; then
    echo "pre-push: suíte completa (Docker necessário)"
    dotnet test backend/Flow4Tech.sln --no-build --nologo -v q -m:1
  fi
else
  echo "AVISO: dotnet não encontrado; testes do backend pulados (o CI roda)." >&2
fi

if command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: biome, typecheck e testes do front"
  pnpm lint
  pnpm -r typecheck
  pnpm -r --if-present test
else
  echo "AVISO: pnpm não encontrado; checagens do front puladas." >&2
fi
