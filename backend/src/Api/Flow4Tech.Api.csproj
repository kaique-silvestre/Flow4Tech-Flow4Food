<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Flow4Tech.Api</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Contract: build-time generation is opt-in (`dotnet build -p:GenerateContract=true`), output is committed. -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(GenerateContract)' == 'true'">true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateContract)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flow4Tech.Tests" />
    <InternalsVisibleTo Include="Flow4Tech.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public API of each module (Application): their permission catalogs are collected from these assemblies. -->
    <ProjectReference Include="../Kernel/Flow4Tech.Kernel.csproj" />
    <ProjectReference Include="../Infrastructure/Data/Flow4Tech.Infrastructure.Data.csproj" />
    <ProjectReference Include="../Infrastructure/Audit/Flow4Tech.Infrastructure.Audit.csproj" />
    <ProjectReference Include="../Organizacao/Application/Flow4Tech.Organizacao.Application.csproj" />
    <ProjectReference Include="../Organizacao/Infrastructure/Flow4Tech.Organizacao.Infrastructure.csproj" />
    <ProjectReference Include="../Identidade/Application/Flow4Tech.Identidade.Application.csproj" />
    <ProjectReference Include="../Identidade/Infrastructure/Flow4Tech.Identidade.Infrastructure.csproj" />
    <ProjectReference Include="../Permissoes/Application/Flow4Tech.Permissoes.Application.csproj" />
    <ProjectReference Include="../Permissoes/Infrastructure/Flow4Tech.Permissoes.Infrastructure.csproj" />
    <ProjectReference Include="../Cardapio/Application/Flow4Tech.Cardapio.Application.csproj" />
    <ProjectReference Include="../Cardapio/Infrastructure/Flow4Tech.Cardapio.Infrastructure.csproj" />
    <ProjectReference Include="../Comandas/Application/Flow4Tech.Comandas.Application.csproj" />
    <ProjectReference Include="../Comandas/Infrastructure/Flow4Tech.Comandas.Infrastructure.csproj" />
    <ProjectReference Include="../Pagamentos/Application/Flow4Tech.Pagamentos.Application.csproj" />
    <ProjectReference Include="../Caixa/Application/Flow4Tech.Caixa.Application.csproj" />
    <ProjectReference Include="../Caixa/Infrastructure/Flow4Tech.Caixa.Infrastructure.csproj" />
  </ItemGroup>

</Project>
