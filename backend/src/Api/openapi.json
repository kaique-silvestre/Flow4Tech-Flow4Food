      "post": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "revogarSessao",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "commit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginRequest": {
        "required": [
          "organizacaoDoLogin",
          "usuario",
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "organizacaoDoLogin": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "usuario": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "senha": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SessaoItem": {
        "required": [
          "id",
          "contaId",
          "unidadeAtivaId",
          "criadaEm",
          "ultimaAtividadeEm",
          "expiraEm",
          "ip",
          "agente",
          "atual"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contaId": {
            "type": "string",
            "format": "uuid"
          },
          "unidadeAtivaId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "ultimaAtividadeEm": {
            "type": "string",
            "format": "date-time"
          },
          "expiraEm": {
            "type": "string",
            "format": "date-time"
          },
          "ip": {
            "type": [
              "null",
              "string"
            ]
          },
          "agente": {
            "type": [
              "null",
              "string"
            ]
          },
          "atual": {
            "type": "boolean"
          }
        }
      },
      "SessaoResponse": {
        "required": [
          "accessToken",
          "expiraEmSegundos",
          "sessaoId",
          "unidadeAtivaId",
          "deveTrocarSenha",
          "requerSelecaoDeUnidade",
          "sessaoExpiraEm"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiraEmSegundos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sessaoId": {
            "type": "string",
            "format": "uuid"
          },
          "unidadeAtivaId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "deveTrocarSenha": {
            "type": "boolean"
          },
          "requerSelecaoDeUnidade": {
            "type": "boolean"
          },
          "sessaoExpiraEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrocarSenhaErro": {
        "required": [
          "codigo",
          "problemas"
        ],
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "problemas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TrocarSenhaRequest": {
        "required": [
          "senhaAtual",
          "novaSenha"
        ],
        "type": "object",
        "properties": {
          "senhaAtual": {
            "type": [
              "null",
              "string"
            ]
          },
          "novaSenha": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TrocarUnidadeRequest": {
        "required": [
          "unidadeDestinoId"
        ],
        "type": "object",
        "properties": {
          "unidadeDestinoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UnidadeAtivaResponse": {
        "required": [
          "unidadeId"
        ],
        "type": "object",
        "properties": {
          "unidadeId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UnidadeResponse": {
        "required": [
          "id",
          "nome"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "VersionInfo": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Flow4Tech.Api"
    }
  ]
}