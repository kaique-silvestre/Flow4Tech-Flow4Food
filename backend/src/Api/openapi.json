{
  "openapi": "3.1.1",
  "info": {
    "title": "Flow4Tech.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/version": {
      "get": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/unidades": {
      "get": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "listUnidades",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnidadeResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/sessao/unidade-ativa": {
      "get": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "getUnidadeAtiva",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnidadeAtivaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Flow4Tech.Api"
        ],
        "operationId": "trocarUnidadeAtiva",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrocarUnidadeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnidadeAtivaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "commit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TrocarUnidadeRequest": {
        "required": [
          "unidadeDestinoId"
        ],
        "type": "object",
        "properties": {
          "unidadeDestinoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UnidadeAtivaResponse": {
        "required": [
          "unidadeId"
        ],
        "type": "object",
        "properties": {
          "unidadeId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UnidadeResponse": {
        "required": [
          "id",
          "nome"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "VersionInfo": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Flow4Tech.Api"
    }
  ]
}