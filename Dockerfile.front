# Front `app` on Railway (F4-0129): Caddy serves the built SPA and proxies the API routes to the API over the private network,
# so the browser sees ONE origin (cookie __Host-f4t_refresh is SameSite=Strict). Same idea as frontend/app/vercel.json.
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/ frontend/
RUN pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm --filter @flow4tech/app build

FROM caddy:2-alpine
COPY --from=build /src/frontend/app/dist /srv
COPY frontend/app/Caddyfile /etc/caddy/Caddyfile
RUN adduser -D -u 10001 web && chown -R web /data /config
USER web
# PORT is injected by Railway; API_UPSTREAM defaults to the API service on the private network.
ENV API_UPSTREAM=flow4tech-api.railway.internal:8080
